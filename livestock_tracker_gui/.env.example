# Use ONE of these DB URLs
# MySQL (recommended for macOS dev)
DB_URL=mysql+pymysql://user:password@localhost:3306/livestock

# OR Microsoft SQL Server (requires ODBC driver setup)
# DB_URL=mssql+pyodbc://user:password@server-host:1433/livestock?driver=ODBC+Driver+17+for+SQL+Server

# macOS command to open files (Preview)
OPEN_CMD=open
